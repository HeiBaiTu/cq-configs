Task={
	TT0001 = "与|C:0x318aff&T:银杏老兵|对话\n\n·点|C:0xf56f00&T:任务名|自动寻路\n·电脑操作时鼠标|C:0xf56f00&T:左键|行走，|C:0xf56f00&T:右键|跑步\n·还可以点任务栏右上角的|C:0xf56f00&T:飞鞋|传送到NPC身边",
	TT0002 = "·按右下角|C:0xf56f00&T:挂机|按钮自动打怪\n·或者用|C:0xf56f00&T:普攻|按钮自动攻击最近的怪物",
	TT0003 = "赶走了烦人的鸡，快去和|C:0x318aff&T:银杏老兵|报告吧\n\n·点|C:0xf56f00&T:任务名|可以自动寻路\n·电脑操作移动时鼠标|C:0xf56f00&T:左键|行走，|C:0xf56f00&T:右键|跑步\n·还可以点任务栏右上角的|C:0xf56f00&T:飞鞋|传送到NPC身边",
	TT0004 = "与|C:0x318aff&T:银杏老兵|对话\n\n·点|C:0xf56f00&T:任务名|可以自动寻路\n·电脑操作移动时鼠标|C:0xf56f00&T:左键|行走，|C:0xf56f00&T:右键|跑步\n·还可以点任务栏右上角的|C:0xf56f00&T:飞鞋|传送到NPC身边",
	TT0005 = "·按右下角|C:0xf56f00&T:挂机|按钮自动打怪\n·或者用|C:0xf56f00&T:普攻|按钮自动攻击最近的怪物",
	TT0006 = "抓到了一只鹿，快去和|C:0x318aff&T:银杏老兵|报告吧\n\n·点|C:0xf56f00&T:任务名|自动寻路\n·电脑操作时鼠标|C:0xf56f00&T:左键|行走，|C:0xf56f00&T:右键|跑步\n·还可以点任务栏右上角的|C:0xf56f00&T:飞鞋|传送到NPC身边",
	TT0007 = "与|C:0x318aff&T:银杏老兵|对话\n\n·点|C:0xf56f00&T:任务名|自动寻路\n·电脑操作时鼠标|C:0xf56f00&T:左键|行走，|C:0xf56f00&T:右键|跑步\n·还可以点任务栏右上角的|C:0xf56f00&T:飞鞋|传送到NPC身边",
	TT0008 = "·按右下角|C:0xf56f00&T:挂机|按钮自动打怪\n·或者用|C:0xf56f00&T:普攻|按钮自动攻击最近的怪物",
	TT0009 = "赶走了猫妖，快去和|C:0x318aff&T:银杏老兵|报告吧\n\n·点|C:0xf56f00&T:任务名|自动寻路\n·电脑操作时鼠标|C:0xf56f00&T:左键|行走，|C:0xf56f00&T:右键|跑步\n·还可以点任务栏右上角的|C:0xf56f00&T:飞鞋|传送到NPC身边",
	TT0010 = "升到7级就能学习第一个技能-基本剑术了，快和|C:0x318aff&T:银杏老兵|了解一下",
	TT0011 = "·升到7级就能自动学习基本剑术(不需要技能书)，非常方便\n·快点打怪升级吧",
	TT0012 = "·点击屏幕右下角|C:0xf56f00&T:技能|查看，20级以下的技能自动学习\n·“基本剑术”已自动学会，能够提升物理攻击力\n·这是个被动技能，不需要设置快捷键",
	TT0013 = "听说要派你去新的地方了，快去问问|C:0x318aff&T:银杏老兵|",
	TT0014 = "·|C:0x318aff&T:银杏老兵|处使用|C:0xf56f00&T:移动传送|免费到比奇城，找到|C:0x318aff&T:比奇老兵|\n·也可以用任务右侧的|C:0xf56f00&T:飞鞋|图标传送\n·或者直接用|C:0xf56f00&T:飞鞋|功能传送到比奇城安全区，找|C:0x318aff&T:比奇老兵|",
	TT0015 = "去问问|C:0x318aff&T:比奇老兵|，如何做好出门的准备",
	TT0016 = "·找|C:0x318aff&T:卫家店|老板看看有哪些武器\n·如果你不认识比奇|C:0x318aff&T:卫家店|在哪，老规矩，点击|C:0xf56f00&T:任务名|寻路前往，或使用任务右侧的|C:0xf56f00&T:飞鞋|图标传送",
	TT0017 = "有了新武器，再去问问|C:0x318aff&T:比奇老兵|，还有没有衣服",
	TT0018 = "·去找|C:0x318aff&T:安家布衣|老板看看合身的衣服\n·点击|C:0xf56f00&T:任务名|寻路前往，或使用任务右侧的|C:0xf56f00&T:飞鞋|图标传送都可以",
	TT0019 = "找|C:0x318aff&T:比奇老兵|帮忙，去弄一套好用的首饰吧",
	TT0020 = "·去找|C:0x318aff&T:首饰店老板|看看适合的首饰吧\n·点击|C:0xf56f00&T:任务名|寻路前往，或使用任务右侧的|C:0xf56f00&T:飞鞋|图标传送都可以",
	TT0021 = "一切都准备好了，告诉|C:0x318aff&T:比奇老兵|，开始考验吧\n\n·技能界面可以直接设置技能快捷键\n·将技能图标拖到快捷栏也可设置快捷键",
	TT0022 = "·右下角|C:0xf56f00&T:设置-药品|可以设定喝药保护\n·右下角|C:0xf56f00&T:设置-物品|功能可以设定物品捡取、显示",
	TT0023 = "消灭了骷髅，快回城告诉|C:0x318aff&T:比奇老兵|\n\n·使用回城技能、任务传送飞鞋都可以回到比奇",
	TT0024 = "第一次没发挥好，再找|C:0x318aff&T:比奇老兵|挑战一次吧\n\n·技能界面可以直接设置技能快捷键\n·将技能图标拖到快捷栏也可设置快捷键",
	TT0025 = "·右下角|C:0xf56f00&T:设置-药品|可以设定喝药保护\n·右下角|C:0xf56f00&T:设置-物品|功能可以设定物品捡取、显示",
	TT0026 = "消灭了骷髅，快回城告诉|C:0x318aff&T:比奇老兵|\n\n·使用回城技能、任务传送飞鞋都可以回到比奇",
	TT0027 = "兵强马壮，迎接更危险的挑战吧\n\n·技能界面可以直接设置技能快捷键\n·将技能图标拖到快捷栏也可设置快捷键",
	TT0028 = "·右下角|C:0xf56f00&T:设置-药品|可以设定喝药保护\n·右下角|C:0xf56f00&T:设置-物品|功能可以设定物品捡取、显示",
	TT0029 = "消灭了骷髅，快回城告诉|C:0x318aff&T:比奇老兵|\n\n·使用回城技能、任务传送飞鞋都可以回到比奇",
	TT0030 = "问问|C:0x318aff&T:比奇老兵|还有什么需要帮忙的吧\n\n·出门之前，背包常备药品，战斗才有保障\n·在各大主城药店使用绑定金币就能购买药品",
	TT0031 = "·21级以上的技能需要自己学习哦，点击屏幕右下角|C:0xf56f00&T:技能|查看\n\n·右下角|C:0xf56f00&T:设置-药品|可以设定喝药保护\n·右下角|C:0xf56f00&T:设置-物品|功能可以设定物品捡取、显示",
	TT0032 = "回复|C:0x318aff&T:比奇老兵|\n\n·使用回城技能、任务传送飞鞋都可以回到比奇",
	TT0033 = "修整完毕，去问问|C:0x318aff&T:比奇老兵|何时出发\n\n·出门之前，背包常备药品，战斗才有保障\n·在各大主城药店使用绑定金币就能购买药品",
	TT0034 = "·21级以上的技能需要自己学习哦，点击屏幕右下角|C:0xf56f00&T:技能|查看\n\n·右下角|C:0xf56f00&T:设置-药品|可以设定喝药保护\n·右下角|C:0xf56f00&T:设置-物品|功能可以设定物品捡取、显示",
	TT0035 = "回复|C:0x318aff&T:比奇老兵|\n\n·使用回城技能、任务传送飞鞋都可以回到比奇",
	TT0036 = "去找|C:0x318aff&T:比奇老兵|准备出发讨伐矿区外围的僵尸\n\n·出门之前，背包常备药品，战斗才有保障\n·在各大主城药店使用绑定金币就能购买药品",
	TT0037 = "·21级以上的技能需要自己学习哦，点击屏幕右下角|C:0xf56f00&T:技能|查看\n\n·右下角|C:0xf56f00&T:设置-药品|可以设定喝药保护\n·右下角|C:0xf56f00&T:设置-物品|功能可以设定物品捡取、显示",
	TT0038 = "回复|C:0x318aff&T:比奇老兵|\n\n·使用回城技能、任务传送飞鞋都可以回到比奇",
	TT0039 = "做大事得自己有实力，先提升到26级\n\n·出门之前，背包常备药品，战斗才有保障\n·在各大主城药店使用绑定金币就能购买药品",
	TT0040 = "·24级开放行会申请，加入行会和朋友一起玩\n·升到25级开放交易功能，点击右侧最下方|C:0xf56f00&T:交易|按钮，看看寄售行其他玩家上架了哪些极品\n·升到26级开放成就系统和金刚石锻造武器",
	TT0041 = "升到了26级，该去问问|C:0x318aff&T:比奇老兵|有什么事了",
	TT0042 = "好不容易到了26级，看看|C:0x318aff&T:比奇老兵|还有什么难题给我",
	TT0043 = "·留意到左下角的多倍经验了吗，挂机利器打怪10倍经验哦，系统每天都会赠送多倍经验\n\n ·|C:0xf56f00&T:技能-通用|中的比奇回城、盟重回城无CD，消耗1点飞鞋\n ·随机技能会消耗1张随机传送卷（传送卷不足时用1点飞鞋代替）",
	TT0044 = "消灭了沃玛怪物，回去告诉|C:0x318aff&T:比奇老兵|",
	TT0045 = "问问|C:0x318aff&T:比奇老兵|打算怎么办",
	TT0046 = "·留意到左下角的多倍经验了吗，挂机利器打怪10倍经验哦，系统每天都会赠送多倍经验\n\n ·|C:0xf56f00&T:技能-通用|中的比奇回城、盟重回城无CD，消耗1点飞鞋\n ·随机技能会消耗1张随机传送卷（传送卷不足时用1点飞鞋代替）",
	TT0047 = "问问|C:0x318aff&T:盟重老兵|死亡山谷的情况",
	TT0048 = "·地穴洞口的NPC可以购买药品，和他们打好关系吧\n·洞口的NPC还可以快速传送到洞穴内，不过需要大量绑定金币",
	TT0049 = "消灭了地牢怪物，回复|C:0x318aff&T:盟重老兵|",
	TT0050 = "先提升到27级，再去找|C:0x318aff&T:盟重老兵|吧\n\n·28级就可以参加石墓烧猪活动，获得大量多倍经验，点击右上方|C:0xf56f00&T:活动|按钮参加",
	TT0051 = "·地牢是练级的好地方，洞口的NPC可以购买药品，和他们打好关系吧\n·洞口的NPC还可以快速传送到洞穴内，不过需要大量绑定金币\n\n·如果你觉得这里的怪物还是太强，去比奇或毒蛇山谷的矿洞也是个选择",
	TT0052 = "升到了27级，该去问问|C:0x318aff&T:盟重老兵|有什么事了",
	TT0053 = "问问老兵有没有追查到什么线索\n\n·28级就可以参加石墓烧猪活动，获得大量多倍经验，点击右上方|C:0xf56f00&T:活动|按钮参加",
	TT0054 = "",
	TT0055 = "消灭了石墓怪物，回去告诉|C:0x318aff&T:盟重老兵|",
	TT0056 = "|C:0x318aff&T:盟重老兵|有话要和你说",
	TT0057 = "·32级有点难升，慢慢来，等空的时候挂机打怪就行了，有经验有绑金，说不定还有小极品\n·挂机无聊的话可以点击右上角|C:0xf56f00&T:活动|和|C:0xf56f00&T:挑战BOSS|，体验一下各类玩法\n·如果多倍经验用光的话，明天上线就有啦。系统每天赠送多倍经验，不在线也会保存哦",
	TT0058 = "升到了32级，去向|C:0x318aff&T:盟重老兵|汇报修炼的成果吧",
	TT0059 = "|C:0x318aff&T:盟重老兵|好像发现了什么新的线索，去找他问问吧",
	TT0060 = "",
	TT0061 = "消灭了石墓怪物，去问问|C:0x318aff&T:盟重老兵|接下来有什么打算",
