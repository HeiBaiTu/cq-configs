	d00150 = "法师星王级手套，纵前路星辰大海，唯勇者叱咤成王",
	d00151 = "道士星王级手套，纵前路星辰大海，唯勇者叱咤成王",
	d00152 = "战士王者级手套，王者之路，海阔天空任我行",
	d00153 = "法师王者级手套，王者之路，海阔天空任我行",
	d00154 = "道士王者级手套，王者之路，海阔天空任我行",
	d00155 = "黑水晶有一种夺人心魄的力量，让战士更有威摄力的项链",
	d00156 = "散发着若有似无的香气，闻之可静心凝神，法师的至爱",
	d00157 = "黄水晶被视为财富的象征，或许真的会让金币增加呢",
	d00158 = "可以保证的是，佩戴后不会成为魔鬼",
	d00159 = "琥珀项坠透射出淡淡暖光，似乎能透过那光见到天地初开的样貌",
	d00160 = "凤凰栖梧桐，明珠显神通，美丽的项链",
	d00161 = "稀有的蓝色翡翠，佩戴后打人特别疼的项链",
	d00162 = "佩戴后任何细节也尽收眼底，蛛丝马迹不在话下",
	d00163 = "绿意悬于胸前，好比将春光收入怀中，累了吹一吹，抒发胸怀又陶冶情操",
	d00164 = "战士沃玛级项链，这根项链会自行漂浮，或许是有与道术有关的神秘力量",
	d00165 = "法师沃玛级项链，紫色水晶制作的项链，充满了生命力",
	d00166 = "道士沃玛级项链，珠子的来源始终不明，于是命为天珠",
	d00167 = "战士祖玛级项链，绿油油的一条项链，远看像一条青虫……不，青龙",
	d00168 = "法师祖玛级项链，受伤的赤月恶魔逃走时掉落了这枚铃铛",
	d00169 = "道士祖玛级项链，你以为它和灵魂战衣是套装吗？很可惜，不是",
	d00170 = "战士赤月级项链，曾被赤月峡谷深处的双头血魔占据，是无名战士留下的高级装备",
	d00171 = "法师赤月级项链，曾受赤月峡谷深处的双头金刚控制，当时断裂的项链已修复了",
	d00172 = "道士赤月级项链，曾由赤月峡谷深处的赤月恶魔看管，是无名道士留下的高级装备",
	d00173 = "战士魔龙级项链，能借助雷霆之力提升战士的力量，由于黑暗的苏醒，它再次出现在世人面前",
	d00174 = "法师魔龙级项链，能借助火焰之力提升法师的法力，由于黑暗的苏醒，它再次出现在世人面前",
	d00175 = "道士魔龙级项链，能借助光明之力提升道士的魔力，由于黑暗的苏醒，它再次出现在世人面前",
	d00176 = "战士战神级项链，百战成神，虽千万人吾往矣",
	d00177 = "法师战神级项链，百战成神，虽千万人吾往矣",
