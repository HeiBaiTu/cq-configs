	d00126 = "道士王者级戒指，王者之路，海阔天空任我行",
	d00127 = "细得像跟绳子，或许该称为手链",
	d00128 = "作为材料的厚实棉布，由湿棉花反复拍打得到的棉片缀成，因此不易磨损",
	d00129 = "铁手镯的升级版，坚固耐用，还不易产生锈斑",
	d00130 = "样式简约美丽，能够帮你痛殴对手的手镯",
	d00131 = "充满着魔力的手镯，带上后莫名感到一股魔力，也许封印了某个魔族？",
	d00132 = "正如法师是天地间清冽的微风，黑檀庄严古朴的淡香最衬他们脱俗的品味",
	d00133 = "道士标志性的装饰品，佩戴后道术能得到提升",
	d00134 = "战士沃玛级手套，敌人将看不清你手上的动作，借此能给予敌人重创",
	d00135 = "法师沃玛级手镯，常在沃玛地区出现，推测是那里的怪物掉落",
	d00136 = "道士沃玛级手镯，造型简约的手镯，戴上后可瞬间安抚心灵",
	d00137 = "战士祖玛级手镯，战士的好伙伴，意为“骑士精神”的几个古文字刻在手镯内侧，时时提醒着它的佩戴者",
	d00138 = "法师祖玛级手镯，手镯上刻有青龙浮纹，象征永不熄灭的阳性",
	d00139 = "道士祖玛级手镯，表面的三颗宝石犹如三颗眼珠，夜深人静时还会转动",
	d00140 = "战士赤月级手镯，曾被赤月峡谷深处的双头血魔占据，是无名战士留下的高级装备",
	d00141 = "法师赤月级手镯，曾受赤月峡谷深处的双头金刚控制，是无名法师留下的高级装备",
	d00142 = "道士赤月级手镯，曾由赤月峡谷深处的赤月恶魔看管，这枚手镯上有洗不掉的血腥味……",
	d00143 = "战士魔龙级手镯，能借助雷霆之力提升战士的力量，由于黑暗的苏醒，它再次出现在世人面前",
