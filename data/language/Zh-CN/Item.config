	d00001 = "木头制成的剑，是新手的好伙伴",
	d00002 = "有精美的菱形暗格花纹，青铜制成的剑",
	d00003 = "攻击范围广，力量大，小心不要脱手",
	d00004 = "生铁铸造的剑，杀伤力一般",
	d00005 = "长三尺余，镡长尺余，首为大环，战阵之利器",
	d00006 = "道士沃玛级武器，弯曲如蛇走，剑身似光游，铁匠的经典之作",
	d00007 = "左中右三根尖刺象征着天地人，立意远大",
	d00008 = "以一敌百的单手大斧，也有高手用来劈柴",
	d00009 = "战士沃玛级武器，最适合面部凶恶的人",
	d00010 = "法师沃玛级武器，使用时若是喊出那句无人知晓的咒语，会发生奇迹",
	d00011 = "战士第一把专属兵刃，刀刃微弯，能给伤口再添一条血沟",
	d00012 = "和炼狱同样有名，人人都爱的大宝剑",
	d00013 = "青青刀光，弯弯月亮，飞虹纵使未出鞘，亦能杀气溢于形",
	d00014 = "带弧度的剑，刚硬不足，优雅有余",
	d00015 = "战士祖玛级武器，如倒映于深井水面的弯月，为野性的战士平添了一丝雅致",
	d00016 = "无青龙之名，却有偃月之威",
	d00017 = "道士祖玛级武器，纤细修长，采自世界之木的树干，混以五行神水得以制成",
	d00018 = "法师祖玛级武器，由战士的武器改良而成的剑，利于攒刺，能给对手造成致命的伤口",
	d00019 = "法师祖玛级武器，能避开一切灾厄",
	d00020 = "战士赤月级武器，裁决世间不平事，挥断尘世不了情",
	d00021 = "道士赤月级武器，为龙纹之路，以入血，持者不伤也",
	d00022 = "战士战神级武器，屠龙在手，天下我有",
	d00023 = "法师战神级武器，只能由意志最坚定的人掌握",
	d00024 = "法师赤月级武器，色如翠玉，质地坚硬，蕴含法力",
	d00025 = "掌握他人命运的利刃，同时也决定着自己的命运",
	d00026 = "用魔族的血所铸，依稀可听到魔剑下，千万魔族亡魂的哭嚎",
	d00027 = "法师魔龙级武器，以巨龙之牙，蕴凡人之力",
	d00028 = "战士魔龙级武器，莫愁前路无知己，挥刀怒斩破荆棘",
	d00029 = "道士魔龙级武器，静静听，仿佛有悲鸣之声……",
	d00030 = "战士星王级武器，开天辟地手中握，誓要屠尽天下魔",
	d00031 = "法师星王级武器，锋芒一露法无边，镇山镇海又镇天",
	d00032 = "道士星王级武器，傲立群魔出狂言，敢叫青天变玄天",
	d00033 = "道士战神级武器，倚天一出，谁与争锋",
	d00034 = "战士王者级武器，王者之路，海阔天空任我行",
	d00035 = "法师王者级武器，王者之路，海阔天空任我行",
	d00036 = "道士王者级武器，王者之路，海阔天空任我行",
	d00037 = "",
	d00038 = "",
	d00039 = "",
	d00040 = "一朵漂亮的鲜花，你想送给谁？",
	d00041 = "时装武器-紫玫瑰，可在角色-时装中激活对应时装特效，并提升属性。时装属性全职业攻击1-1",
	d00042 = "时装武器-金玫瑰，可在角色-时装中激活对应时装特效，并提升属性。时装属性全职业攻击0-2",
	d00043 = "时装武器-黄金裁决，可在角色-时装中激活对应时装特效，并提升属性。时装属性攻击3-7、魔法3-6、道术3-6",
	d00044 = "时装武器-黄金嗜魂，可在角色-时装中激活对应时装特效，并提升属性。时装属性攻击3-6、魔法3-7、道术3-6",
	d00045 = "时装武器-黄金羽扇，可在角色-时装中激活对应时装特效，并提升属性。时装属性攻击3-6、魔法3-6、道术3-7",
	d00046 = "时装武器-黄金屠龙，可在角色-时装中激活对应时装特效，并提升属性。时装属性攻击4-6、魔法4-6、道术4-6",
	d00047 = "人与动物最大的区别是，人有羞耻心",
	d00048 = "一般士兵会穿的盔甲，能起一定的防护作用",
	d00049 = "外表笨重的盔甲，只有肌肉结实的战士才不会被压趴下",
	d00050 = "虽然是入门装备，但足以让新手法师信心大增",
	d00051 = "使用灵魂之力缝制的战衣，战斗时会感到你不是一个人",
	d00052 = "翠玉般的色彩青春洋溢，带来清风的气息，让人打从心底仰慕不已",
	d00053 = "为了警告法师不要堕落为恶魔，才取了这个名字",
	d00054 = "隐藏在暗处，给予敌人出其不意的一击",
	d00055 = "比轻型盔甲更贵一点，不过好像看不出有什么两样",
	d00056 = "使用灵魂之力缝制的战衣，战斗时会感到你不是一个人",
	d00057 = "战士赤月级衣服，男女通用，黑色为底，金光闪亮的铠甲，背后的双翅犹如正义之翼，彰显战士的一颗正义之心",
	d00058 = "法师赤月级衣服，男女通用，血红色的披风仿佛残阳，随风舞动时，叫人感受到何为瞬息万变的人生",
	d00059 = "道士赤月级衣服，男女通用，白色象征纯洁无暇的品性，紫色突显尊贵，点点绿色如春意盎然，是一件生机无限的道袍",
	d00060 = "战士赤月级衣服，便于行动的黑色，以示战士的冷酷与神秘，绿与金的搭配，不仅豪华，更有一种自然之力的流露",
	d00061 = "法师赤月级衣服，贴身的剪裁突显身段，大胆的色彩直击人心，即使在战场上也叫人目不转睛",
	d00062 = "道士赤月级衣服，青色的长裙突显尊贵，金色花纹错落精致，白色象征无暇的品性，点点翠色是生机无限的象征",
	d00063 = "战士王者级衣服，王者之路，海阔天空任我行",
	d00064 = "战士王者级衣服，王者之路，海阔天空任我行",
	d00065 = "法师王者级衣服，王者之路，海阔天空任我行",
	d00066 = "法师王者级衣服，王者之路，海阔天空任我行",
	d00067 = "道士王者级衣服，王者之路，海阔天空任我行",
	d00068 = "道士王者级衣服，王者之路，海阔天空任我行",
	d00069 = "白衣胜雪，衣诀轻染着蓝与红，仿佛无垠天空之上的蓝天和残阳，彰显着一城之主的威严",
	d00070 = "白衣胜雪，衣诀轻染着蓝与红，仿佛无垠天空之上的蓝天和残阳，彰显着一城之主的威严",
	d00071 = "三职业魔龙级衣服，红色的外表潜藏着战斗的激情",
	d00072 = "三职业魔龙级衣服，红色的外表潜藏着战斗的激情",
	d00073 = "三职业战神级衣服，震慑一切的万兽之王，终于找到有资格穿上它的主人",
	d00074 = "三职业战神级衣服，震慑一切的万兽之王，终于找到有资格穿上它的主人",
	d00075 = "三职业星王级衣服，纵前路星辰大海，唯勇者叱咤成王",
	d00076 = "这是附加了咒语的青铜头盔，能更好防护魔法的攻击",
	d00077 = "青铜打造，普普通通的头盔",
	d00078 = "法师赤月级头盔，曾受赤月峡谷深处的双头金刚控制，是无名法师留下的高级装备",
	d00079 = "道士赤月级头盔，曾由赤月峡谷深处的赤月恶魔看管，是无名道士留下的高级装备",
	d00080 = "伪装成骷髅，就不会被洞穴的怪物发现了",
	d00081 = "战士赤月级头盔，曾被赤月峡谷深处的双头血魔占有，这件头盔在后脑处有一块怎么也擦不掉的血迹……",
	d00082 = "战士星王级头盔，纵前路星辰大海，唯勇者叱咤成王",
	d00083 = "法师星王级头盔，纵前路星辰大海，唯勇者叱咤成王",
	d00084 = "道士星王级头盔，纵前路星辰大海，唯勇者叱咤成王",
	d00085 = "战士王者级头盔，王者之路，海阔天空任我行",
	d00086 = "法师王者级头盔，王者之路，海阔天空任我行",
	d00087 = "道士王者级头盔，王者之路，海阔天空任我行",
	d00088 = "由闻名一方的铁匠打造，可增强道士的道术",
	d00089 = "由冤死的灵魂打造而成，盔沿刻有祈祷铭文",
	d00090 = "三职业祖玛级头盔，用最坚硬的黑铁整整锻造了七七四十九天的头盔",
	d00091 = "战士魔龙级头盔，能借助雷霆之力提升战士的力量，由于黑暗的苏醒，它再次出现在世人面前",
	d00092 = "法师魔龙级头盔，能借助火焰之力提升法师的法力，由于黑暗的苏醒，它再次出现在世人面前",
	d00093 = "道士魔龙级头盔，能借助光明之力提升道士的魔力，由于黑暗的苏醒，它再次出现在世人面前",
	d00094 = "战士战神级头盔，百战成神，虽千万人吾往矣",
	d00095 = "法师战神级头盔，百战成神，虽千万人吾往矣",
	d00096 = "道士战神级头盔，百战成神，虽千万人吾往矣",
	d00097 = "在阳光下闪闪发亮，有人用它向心仪的姑娘求婚，结果当然是……",
	d00098 = "少见的形状让不少人对六角戒指趋之若鹜，除此之外并无特别之处",
	d00099 = "造型古朴的戒指，戴上后让人莫名很心安",
	d00100 = "黑色水晶深沉又神秘，这枚戒指就像一位沉默的守护者",
	d00101 = "蛮族认为蛇眼具有通晓一切的能力",
	d00102 = "珍珠泛着温润的光泽，戒指也因此增色不少",
	d00103 = "戒指上的骷髅栩栩如生，令人怀疑它的来历",
	d00104 = "魅力戒指让你更有自信",
	d00105 = "牛魔洞里的怪物为什么会掉道德戒指……？匪夷所思",
	d00106 = "战士沃玛级戒指，戒身刻有青龙浮纹，象征永不熄灭的怒火",
	d00107 = "法师沃玛级戒指，深邃的红色让人联想到鲜血，却也有几分华贵的戒指",
	d00108 = "道士沃玛级戒指，精雕细琢而成的细巧戒指",
	d00109 = "战士祖玛级戒指，看上去很小，但是戒指的重量堪比一颗石头，非常考验佩戴者的力量",
	d00110 = "法师祖玛级戒指，有点点绿斑的天然紫海螺制成的戒指",
	d00111 = "道士祖玛级戒指，佩戴后将得到上古神族泰坦的加护",
	d00112 = "战士赤月级戒指，曾被赤月峡谷深处的双头血魔占据，是无名战士留下的高级装备",
	d00113 = "法师赤月级戒指，曾受赤月峡谷深处的双头金刚控制，是无名法师留下的高级装备",
	d00114 = "道士赤月级戒指，曾由赤月峡谷深处的赤月恶魔看管，是无名道士留下的高级装备",
	d00115 = "战士魔龙级戒指，能借助雷霆之力提升战士的力量，由于黑暗的苏醒，它再次出现在世人面前",
	d00116 = "法师魔龙级戒指，能借助火焰之力提升法师的法力，由于黑暗的苏醒，它再次出现在世人面前",
