	h00001 = "消灭所有石墓阵怪物，就能获得大量经验\n\n\n|C:0x2eb52d&T:等级28级 消耗绑金2万|",
	h00002 = "消灭所有石墓阵怪物，就能获得大量经验（参加需要石墓挑战卷）\n\n|C:0x2eb52d&T:等级28级 消耗石墓挑战卷*1 绑金2万|",
