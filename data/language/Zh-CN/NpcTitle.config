	n0181 = "送宝人偶",
	n0182 = "村长",
	s0090 = "想去比奇城吗？我可以送你一程。",
	s0091 = "欢迎来到银杏山谷，我可以为你做什么吗？",
	s0092 = "你好，你需要点什么？",
	s0093 = "欢迎，这儿还不错吧",
	s0094 = "想去比奇城吗？我可以送你一程。",
	s0095 = "欢迎，我能为你做点什么？",
	s0096 = "欢迎，感谢你来这里。",
	s0097 = "您想卖肉吗？",
	s0098 = "欢迎，你需要点什么？",
	s0099 = "欢迎光临，有什么事情吗？",
	s0100 = "看看我这里的家伙有多称手。",
	s0101 = "欢迎光临，有什么需要我帮忙吗？",
	s0102 = "欢迎，在这里你可以买一些常见的药品。",
	s0103 = "你看，这些都是A级的。",
	s0104 = "目前不收保管费，请多利用。",
	s0105 = "是来卖肉吗？",
	s0106 = "比奇城是玛法大路上最繁华的城市，我有很多有趣的事，你想不想听啊？",
	s0107 = "读书破万卷，下笔如有神。",
	s0108 = "这里是比奇皇宫，我就是这里的国王。",
	s0109 = "欢迎，你需要点什么？",
	s0110 = "是来卖肉吗？",
	s0111 = "别看老夫衣着邋遢，其实我也是个有梦想的人，从小我就梦想做玛法第一的祝福油大亨，而现在梦想显然已经实现了！",
	s0112 = "最新通告！",
	s0113 = "看来你需要我的帮助。",
	s0114 = "沙巴克就在盟重，你想去一睹沙巴克城主的风采吗？",
	s0115 = "欢迎光临，感谢您到我们的铁匠铺。",
	s0116 = "欢迎，这里有你想要的。",
	s0117 = "这里的东西都是货真价实的。",
	s0118 = "需要帮什么忙？目前不收保管费，请多利用。",
	s0119 = "书中自有黄金屋。",
	s0120 = "你还记得当年沙城的故事吗？",
	s0121 = "在这里你就得听沙巴克主人的命令！",
	s0122 = "我这儿可没有禁售的药品！",
	s0123 = "欢迎，我们有各种各样的衣服。",
	s0124 = "你是沙巴克行会的成员吗？我可以给你个特惠价哦。",
	s0125 = "也许你已经不认识我了，但没有关系，我手艺还在。只要你给钱，我还是能满足你的所有要求！",
	s0126 = "你好啊，快来买点东西，现在我生意好得很，完了你就买不到了！",
	s0127 = "只要有勇气接受挑战，总有一天我们一定能够回家。",
	s0128 = "这岛上只有我一家，别怪我坐地起价。",
	s0129 = "欢迎光临，有什么事情需要我帮忙吗？",
	s0130 = "手镯、戒指、项链都让我来帮你处理好了",
	s0131 = "你想买什么药？",
	s0132 = "要不是为了钱，我也不会到这么危险的地方来做买卖。",
	s0133 = "我的功夫你应该不会怀疑吧。那群徒弟嘛也算是学有所成了。唉，要不是这把老骨头，我也真想同他们一道去闯荡闯荡！",
	s0134 = "站在这里浑身僵得像石头。师傅老说北方有蜘蛛，不让我们出去，可我只见过一些半兽人什么的，蜘蛛到底在哪里？",
	s0135 = "我表妹在比奇开首饰店，天天站着等我。听说老有人和她搭讪，问七问八的，真不放心啊。",
	s0136 = "披上盔甲，我还是天下最好的战士！我要去赤月峡谷找上次那个血巨人再拼一次！上次好险，辛亏师傅救我，这次我肯定成功！",
	s0137 = "啊，又有人来了！真难为情……人家练功不习惯被人看着嘛。",
	s0138 = "看什么看？没见过帅哥啊！你再看……你再看……在看我打你！我可会野蛮冲撞啊！",
	s0139 = "蜘蛛算什么！我家里有的是！",
	s0140 = "年轻人，你也和我一样坚信我们终有一天能回家吗？只要有勇气接受挑战，什么困难都能征服！你想去什么地方接受锤炼呢，也许我可以送你一程！",
	s0141 = "我们道士啊，就是心灵手巧。想当年我是有名的药师呢！对了你要点什么啊？",
	s0142 = "欢迎，我是老板兼裁缝。需要我做点什么吗？",
	s0143 = "欢迎，我们经营精美首饰。",
	s0144 = "你好啊，快来买点东西，现在我生意好的很，晚了你就买不到了。",
	s0145 = "道可道，非常道。",
	s0146 = "赤月恶魔的势力正在扩展，罪恶正在临近。年轻人，你已经处在危险的边缘，你愿意远征赤月峡谷吗？我无法传授你任何武功，但我可以透露给你一个秘密：赤月恶魔的唯一弱点就是……听见了吗？好了，你去吧。",
	s0147 = "此路是比奇通往盟重的必经之路，但若实力不足，就会成为一条不归路。",
	s0148 = "欢迎，过了这个村，可就再没这个店了啊。",
	s0149 = "欢迎，你需要点什么？以前金矿值钱的时候，这里可是人山人海。",
	s0150 = "欢迎，欢迎光临。",
	s0151 = "欢迎光临，有什么需要我帮忙吗？",
	s0152 = "听封魔谷这个名字就知道这儿是多么危险的地方，你有勇气去接受挑战吗？",
	s0153 = "这里太危险了，你不要到处乱逛！",
	s0154 = "看来你需要我的帮助，因为这里只有我一家卖东西。",
	s0155 = "以你的实力目前还不能进入此地，请回吧！",
	s0156 = "待人以宽，处事随和才是做人的方式，你都到这里了，应该明白这个道理了吧。",
	s0157 = "我可以将你传送到指定地图，不过费用可不低。洞穴的怪物异常凶险，最好带足了药品再进去。",
	s0158 = "我可以将你传送到指定地图，不过费用可不低。洞穴的怪物异常凶险，最好带足了药品再进去。",
	s0159 = "我可以将你传送到指定地图，不过费用可不低。洞穴的怪物异常凶险，最好带足了药品再进去。",
